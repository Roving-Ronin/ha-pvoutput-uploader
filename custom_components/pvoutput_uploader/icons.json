{
  "entity": {
    "sensor": {
      "last_upload": { "default": "mdi:cloud-upload-outline" },
      "last_download": { "default": "mdi:cloud-download-outline" },
      "history_download": { "default": "mdi:database-arrow-down-outline" },
      "normalised_output": { "default": "mdi:solar-power-variant-outline" },
      "pending_samples": { "default": "mdi:tray-full" },
      "queued_outputs": { "default": "mdi:calendar-clock" },
      "failed_samples": { "default": "mdi:alert-circle-outline" },
      "failed_outputs": { "default": "mdi:calendar-remove" },
      "partial_samples": { "default": "mdi:progress-alert" },
      "cleared_samples": { "default": "mdi:playlist-remove" },
      "without_battery_samples": { "default": "mdi:battery-off-outline" },
      "history_samples": { "default": "mdi:database" },
      "history_oldest": { "default": "mdi:history" },
      "rate_limit_remaining": { "default": "mdi:speedometer" },
      "paused_until": { "default": "mdi:timer-pause-outline" },
      "account_type": { "default": "mdi:account-star" },
      "last_error": { "default": "mdi:alert-outline" }
    },
    "button": {
      "clear_queue": { "default": "mdi:playlist-remove" }
    },
    "switch": {
      "uploading": {
        "default": "mdi:cloud-upload",
        "state": { "off": "mdi:cloud-off-outline" }
      },
      "downloading": {
        "default": "mdi:cloud-download",
        "state": { "off": "mdi:cloud-off-outline" }
      },
      "daily_history": {
        "default": "mdi:database-arrow-down",
        "state": { "off": "mdi:database-off-outline" }
      }
    }
  },
  "services": {
    "reupload": { "service": "mdi:cloud-upload-outline" },
    "import_from_recorder": { "service": "mdi:database-import" }
  }
}
